{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "http://localhost:8090" },
        { "url": "http://localhost:8090/**" },
        { "url": "http://localhost:8091" },
        { "url": "http://localhost:8091/**" },
        { "url": "http://127.0.0.1:8090" },
        { "url": "http://127.0.0.1:8090/**" },
        { "url": "http://127.0.0.1:8091" },
        { "url": "http://127.0.0.1:8091/**" }
      ]
    }
  ]
}
