{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "os:default",
    "clipboard-manager:allow-read-text",
    "clipboard-manager:allow-write-text",
    "process:default",
    "updater:default",
    "allow-net",
    "allow-device-get-battery",
    "allow-device-write-download",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "http://*.dadi" },
        { "url": "http://*.dadi/**" },
        { "url": "http://127.0.0.1:*" },
        { "url": "http://127.0.0.1:*/**" },
        { "url": "http://localhost:*" },
        { "url": "http://localhost:*/**" }
      ]
    }
  ]
}
