<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Network Extension entitlements for com.dadi.hath.dadimesh (macOS + iOS).
  Apply to the Packet Tunnel Provider target in Xcode after `tauri ios init`
  / macOS NE target creation. App target needs personal-vpn + app-groups too.
-->
<plist version="1.0">
<dict>
	<key>com.apple.developer.networking.networkextension</key>
	<array>
		<string>packet-tunnel-provider</string>
	</array>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.dadi.hath</string>
	</array>
	<key>com.apple.developer.team-identifier</key>
	<string>$(DEVELOPMENT_TEAM)</string>
</dict>
</plist>
