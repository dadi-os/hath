# GitHub Actions secrets / vars for hath CD.
# Copy these into the hath repo: Settings → Secrets and variables → Actions.
# Do not put real values in this file. It is a checklist, not a credentials store.

# ── Shared Apple (App Store Connect API key) ──────────────────────────────────
# Create at https://appstoreconnect.apple.com/access/integrations/api
# Role: App Manager (or Admin). Download the .p8 once.

APPLE_API_KEY_ID=          # Key ID column (e.g. AB12CD34EF)
APPLE_API_ISSUER=          # Issuer ID shown above the keys table (UUID)
APPLE_API_PRIVATE_KEY=     # Full contents of AuthKey_<KEY_ID>.p8 (including BEGIN/END lines)

APPLE_TEAM_ID=             # 10-character Team ID from developer.apple.com → Membership

# ── macOS desktop (.dmg) signing + notarization (optional) ────────────────────
# Without these, CI still uploads an unsigned .dmg (Gatekeeper will warn).
# Certificate: Developer ID Application (NOT Apple Distribution).

APPLE_CERTIFICATE=              # base64 of the .p12:  base64 -i cert.p12 | pbcopy
APPLE_CERTIFICATE_PASSWORD=     # password used when exporting the .p12
APPLE_SIGNING_IDENTITY=         # e.g. "Developer ID Application: Your Name (TEAMID)"
APPLE_ID=                       # Apple ID email used for notarization
APPLE_ID_PASSWORD=              # App-specific password (appleid.apple.com → App-Specific Passwords)
# Notarization also uses APPLE_API_* above (preferred over APPLE_ID_PASSWORD).

# ── iOS / TestFlight ──────────────────────────────────────────────────────────
# Required for a signed IPA and TestFlight upload. Without these, the iOS job
# skips build/upload and prints a notice (desktop releases still publish).
#
# Prerequisites in Apple Developer / App Store Connect:
#   1. App ID matching tauri.conf.json identifier: com.dadi.hath
#   2. App record in App Store Connect for that bundle ID
#   3. Apple Distribution certificate (iOS Distribution) — not Developer ID
#   4. App Store / Ad Hoc provisioning profile for com.dadi.hath
#
# Export:
#   CERT:     base64 -i ios_distribution.p12 | pbcopy
#   PROFILE:  base64 -i Hath_AppStore.mobileprovision | pbcopy

APPLE_IOS_CERTIFICATE=              # base64 of Apple Distribution .p12
APPLE_IOS_CERTIFICATE_PASSWORD=     # .p12 password
APPLE_IOS_PROVISIONING_PROFILE=     # base64 of the .mobileprovision
APPLE_IOS_SIGNING_IDENTITY=         # e.g. "Apple Distribution: Your Name (TEAMID)"
# Upload uses APPLE_API_KEY_ID / APPLE_API_ISSUER / APPLE_API_PRIVATE_KEY above.

# ── Windows code signing (optional, not wired yet) ────────────────────────────
# Unsigned NSIS installers work; SmartScreen will warn until you add signing.
# WINDOWS_CERTIFICATE=
# WINDOWS_CERTIFICATE_PASSWORD=

# ── Release asset names (no secrets; for reference) ───────────────────────────
# Published on each main push to GitHub Release vX.Y.Z (from package.json):
#   hath-linux-x86_64.AppImage   ← regular Linux install; Nas configures kiosk
#   hath-macos-aarch64.dmg
#   hath-windows-x86_64-setup.exe
#   hath-ios.ipa                 ← also uploaded to TestFlight when iOS secrets set
