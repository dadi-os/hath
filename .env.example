# Build target: kiosk | desktop | mobile
HATH_TARGET=desktop

# Set to 1 to use the embedded tsnet node (mobile always uses tsnet).
# HATH_TSNET=1

# Headscale coordination server (required when tsnet is active).
# HATH_CONTROL_URL=https://headscale.example.com

# Local Docker defaults (plain HTTP)
DIMAAG_URL=http://localhost:8091
YAAD_URL=http://localhost:8090

# When HATH_TSNET=1 / mobile, use MagicDNS names instead:
# DIMAAG_URL=http://dimaag:8080
# YAAD_URL=http://yaad:8080
